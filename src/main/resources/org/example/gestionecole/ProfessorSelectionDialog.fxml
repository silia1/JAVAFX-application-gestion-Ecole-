<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.gestionecole.controllers.ProfessorSelectionController">
        <Label text="Select a Professor" />
        <TableView fx:id="professorTable">
            <columns>
                <TableColumn text="First Name" fx:id="prenomColumn" />
                <TableColumn text="Last Name" fx:id="nomColumn" />
            </columns>
        </TableView>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Select" onAction="#handleSelect" />
            <Button text="Cancel" onAction="#handleCancel" />
        </HBox>
    </VBox>

